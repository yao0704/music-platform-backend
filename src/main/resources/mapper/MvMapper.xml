<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.music.musicplatform.mapper.MvMapper">
    <select id="selectList" resultType="com.music.musicplatform.domain.Mv">
        SELECT * FROM mv
        <where>
            <if test="style != null and style != ''">
                AND style = #{style}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <select id="selectById" resultType="com.music.musicplatform.domain.Mv">
        SELECT * FROM mv WHERE id = #{id}
    </select>

    <select id="selectDistinctStyles" resultType="java.lang.String">
        SELECT DISTINCT style FROM mv WHERE style IS NOT NULL
    </select>
</mapper>