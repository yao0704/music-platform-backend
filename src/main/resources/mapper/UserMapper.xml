<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.music.musicplatform.mapper.UserMapper">
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user (username, password, nickname, gender, avatar)
        VALUES (#{username}, #{password}, #{nickname}, #{gender}, #{avatar})
    </insert>

    <select id="selectByUsername" resultType="com.music.musicplatform.domain.User">
        SELECT * FROM user WHERE username = #{username}
    </select>
    <!-- 新增：根据ID查询 -->
    <select id="selectById" resultType="com.music.musicplatform.domain.User">
        SELECT * FROM user WHERE id = #{id}
    </select>

    <!-- 新增：更新昵称、性别、头像 -->
    <update id="updateById">
        UPDATE user
        <set>
            <if test="nickname != null">nickname = #{nickname},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
        </set>
        WHERE id = #{id}
    </update>
</mapper>